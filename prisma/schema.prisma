generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  CASHIER
}

enum BillType {
  WHOLESALE
  RETAIL
  QUOTATION
}

enum PaymentType {
  CREDIT
  DEBIT
}

model User {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String
  name      String
  role      Role     @default(CASHIER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Brand {
  id        String    @id @default(cuid())
  name      String    @unique
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Product {
  id              String           @id @default(cuid())
  code            String           @unique
  name            String
  costPrice       Decimal          @db.Decimal(10, 2)
  wholesalePrice  Decimal          @db.Decimal(10, 2)
  retailPrice     Decimal          @db.Decimal(10, 2)
  stock           Int              @default(0)
  categoryId      String?
  category        Category?        @relation(fields: [categoryId], references: [id])
  brandId         String?
  brand           Brand?           @relation(fields: [brandId], references: [id])
  supplierId      String?
  supplier        Supplier?        @relation(fields: [supplierId], references: [id])
  saleItems       SaleItem[]
  saleReturnItems SaleReturnItem[]
  purchaseItems   PurchaseItem[]
  demands         Demand[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model Customer {
  id        String       @id @default(cuid())
  name      String
  contact   String
  cnic      String?
  balance   Decimal      @default(0) @db.Decimal(15, 2)
  address   String?
  sales     Sale[]
  returns   SaleReturn[]
  ledgers   Ledger[]
  payments  Payment[]
  repairs   Repair[]
  demands   Demand[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

model Sale {
  id         String       @id @default(cuid())
  billNumber String       @unique
  date       DateTime     @default(now())
  type       BillType
  customerId String
  customer   Customer     @relation(fields: [customerId], references: [id])
  total      Decimal      @db.Decimal(15, 2)
  discount   Decimal      @default(0) @db.Decimal(15, 2)
  netTotal   Decimal      @db.Decimal(15, 2)
  paidAmount Decimal      @default(0) @db.Decimal(15, 2)
  balance    Decimal      @default(0) @db.Decimal(15, 2)
  items      SaleItem[]
  returns    SaleReturn[]
  ledgers    Ledger[]
  createdAt  DateTime     @default(now())
}

model SaleItem {
  id        String  @id @default(cuid())
  saleId    String
  sale      Sale    @relation(fields: [saleId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  name      String  @default("") // Custom product name at the time of sale
  quantity  Int
  price     Decimal @db.Decimal(10, 2)
  discount  Decimal @default(0) @db.Decimal(10, 2)
  subtotal  Decimal @db.Decimal(15, 2)
}

model SaleReturn {
  id           String           @id @default(cuid())
  returnNumber String           @unique
  date         DateTime         @default(now())
  saleId       String?
  sale         Sale?            @relation(fields: [saleId], references: [id])
  customerId   String
  customer     Customer         @relation(fields: [customerId], references: [id])
  totalAmount  Decimal          @db.Decimal(15, 2)
  refundAmount Decimal          @default(0) @db.Decimal(15, 2)
  creditAmount Decimal          @default(0) @db.Decimal(15, 2)
  remarks      String?
  items        SaleReturnItem[]
  ledgers      Ledger[]
  createdAt    DateTime         @default(now())
}

model SaleReturnItem {
  id           String     @id @default(cuid())
  saleReturnId String
  saleReturn   SaleReturn @relation(fields: [saleReturnId], references: [id], onDelete: Cascade)
  productId    String
  product      Product    @relation(fields: [productId], references: [id])
  name         String     @default("")
  quantity     Int
  price        Decimal    @db.Decimal(10, 2)
  subtotal     Decimal    @db.Decimal(15, 2)
}

model Ledger {
  id           String      @id @default(cuid())
  customerId   String
  customer     Customer    @relation(fields: [customerId], references: [id])
  date         DateTime    @default(now())
  description  String
  debit        Decimal     @default(0) @db.Decimal(15, 2)
  credit       Decimal     @default(0) @db.Decimal(15, 2)
  balance      Decimal     @db.Decimal(15, 2)
  saleId       String?
  sale         Sale?       @relation(fields: [saleId], references: [id])
  saleReturnId String?
  saleReturn   SaleReturn? @relation(fields: [saleReturnId], references: [id])
  paymentId    String?
  payment      Payment?    @relation(fields: [paymentId], references: [id])
  createdAt    DateTime    @default(now())
}

model Payment {
  id          String      @id @default(cuid())
  amount      Decimal     @db.Decimal(15, 2)
  date        DateTime    @default(now())
  type        PaymentType @default(CREDIT)
  method      String?     @default("CASH")
  remarks     String?
  description String?
  customerId  String
  customer    Customer    @relation(fields: [customerId], references: [id])
  ledgers     Ledger[]
  createdAt   DateTime    @default(now())
}

// ==========================================
// SUPPLIERS & PURCHASES (STOCK IN)
// ==========================================

model Supplier {
  id          String            @id @default(cuid())
  name        String
  companyName String?
  contact     String
  email       String?
  address     String?
  cnic        String?
  balance     Decimal           @default(0) @db.Decimal(15, 2) // Current payable amount to supplier
  products    Product[]
  purchases   Purchase[]
  ledgers     SupplierLedger[]
  payments    SupplierPayment[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model Purchase {
  id            String           @id @default(cuid())
  invoiceNumber String           @unique
  date          DateTime         @default(now())
  supplierId    String
  supplier      Supplier         @relation(fields: [supplierId], references: [id])
  total         Decimal          @db.Decimal(15, 2)
  discount      Decimal          @default(0) @db.Decimal(15, 2)
  netTotal      Decimal          @db.Decimal(15, 2)
  paidAmount    Decimal          @default(0) @db.Decimal(15, 2)
  balance       Decimal          @default(0) @db.Decimal(15, 2)
  notes         String?
  items         PurchaseItem[]
  ledgers       SupplierLedger[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
}

model PurchaseItem {
  id          String   @id @default(cuid())
  purchaseId  String
  purchase    Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  name        String   @default("")
  quantity    Int
  costPrice   Decimal  @db.Decimal(10, 2)
  retailPrice Decimal? @db.Decimal(10, 2)
  subtotal    Decimal  @db.Decimal(15, 2)
}

model SupplierLedger {
  id          String           @id @default(cuid())
  supplierId  String
  supplier    Supplier         @relation(fields: [supplierId], references: [id])
  date        DateTime         @default(now())
  description String
  debit       Decimal          @default(0) @db.Decimal(15, 2) // Payment to supplier (reduces payable)
  credit      Decimal          @default(0) @db.Decimal(15, 2) // Purchase bill (increases payable)
  balance     Decimal          @db.Decimal(15, 2)
  purchaseId  String?
  purchase    Purchase?        @relation(fields: [purchaseId], references: [id])
  paymentId   String?
  payment     SupplierPayment? @relation(fields: [paymentId], references: [id])
  createdAt   DateTime         @default(now())
}

model SupplierPayment {
  id          String           @id @default(cuid())
  supplierId  String
  supplier    Supplier         @relation(fields: [supplierId], references: [id])
  amount      Decimal          @db.Decimal(15, 2)
  date        DateTime         @default(now())
  method      String?          @default("CASH")
  remarks     String?
  description String?
  ledgers     SupplierLedger[]
  createdAt   DateTime         @default(now())
}

// ==========================================
// EXPENSE MANAGEMENT WITH DYNAMIC HEADERS
// ==========================================

model ExpenseCategory {
  id          String    @id @default(cuid())
  name        String    @unique // E.g., Rent, Utilities, Salaries, Tea/Refreshments, Transportation, Maintenance, Packaging
  description String?
  expenses    Expense[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Expense {
  id            String          @id @default(cuid())
  voucherNumber String          @unique
  categoryId    String
  category      ExpenseCategory @relation(fields: [categoryId], references: [id])
  title         String
  amount        Decimal         @db.Decimal(15, 2)
  date          DateTime        @default(now())
  paymentMethod String          @default("CASH") // CASH, BANK, ONLINE, CHEQUE
  paidTo        String?
  notes         String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

// ==========================================
// REPAIRS & MAINTENANCE MANAGEMENT
// ==========================================

enum RepairStatus {
  RECEIVED
  DIAGNOSING
  WAITING_FOR_PARTS
  IN_PROGRESS
  READY
  DELIVERED
  UNREPAIRABLE
  CANCELLED
}

enum RepairPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model Repair {
  id                  String         @id @default(cuid())
  ticketNumber        String         @unique
  customerId          String?
  customer            Customer?      @relation(fields: [customerId], references: [id])
  customerName        String
  customerPhone       String
  customerCnic        String?
  customerAddress     String?
  deviceType          String         @default("Laptop") // Laptop, Desktop PC, Printer, LCD/LED, etc.
  deviceBrand         String?
  deviceModel         String?
  serialNumber        String?
  devicePassword      String?        // Password / PIN for testing
  accessoriesIncluded String?        // Charger, Bag, Power cable, etc.
  conditionNotes      String?        // Scratches, cracks, pre-existing damages
  problemDescription  String         @db.Text
  diagnosticsNotes    String?        @db.Text
  status              RepairStatus   @default(RECEIVED)
  priority            RepairPriority @default(NORMAL)
  estimatedCost       Decimal        @default(0) @db.Decimal(15, 2)
  partCost            Decimal        @default(0) @db.Decimal(15, 2)
  laborCost           Decimal        @default(0) @db.Decimal(15, 2)
  finalAmount         Decimal        @default(0) @db.Decimal(15, 2)
  paidAmount          Decimal        @default(0) @db.Decimal(15, 2)
  balance             Decimal        @default(0) @db.Decimal(15, 2)
  paymentMethod       String?        @default("CASH")
  technicianName      String?
  receivedDate        DateTime       @default(now())
  expectedDate        DateTime?
  completedDate       DateTime?
  deliveredDate       DateTime?
  notes               String?        @db.Text
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
}

// ==========================================
// DEMAND & PURCHASE REQUISITION MANAGEMENT
// ==========================================

enum DemandStatus {
  PENDING
  ORDERED
  ARRIVED
  FULFILLED
  CANCELLED
}

enum DemandPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum DemandType {
  CUSTOMER_DEMAND
  STOCK_LOW
  MARKET_PURCHASE
}

model Demand {
  id            String         @id @default(cuid())
  demandNumber  String         @unique // e.g. DMD-2026-0001
  itemName      String
  category      String?
  brand         String?
  quantity      Int            @default(1)
  targetPrice   Decimal?       @default(0) @db.Decimal(15, 2)
  advancePaid   Decimal?       @default(0) @db.Decimal(15, 2)
  type          DemandType     @default(CUSTOMER_DEMAND)
  priority      DemandPriority @default(NORMAL)
  status        DemandStatus   @default(PENDING)

  // Customer reference
  customerId    String?
  customer      Customer?      @relation(fields: [customerId], references: [id])
  customerName  String?
  customerPhone String?

  // Catalog Product reference (optional)
  productId     String?
  product       Product?       @relation(fields: [productId], references: [id])

  supplierName  String?
  notes         String?        @db.Text
  expectedDate  DateTime?
  fulfilledDate DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

